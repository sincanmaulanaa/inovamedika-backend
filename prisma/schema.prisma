model audit_logs {
  id                                                                            BigInt                   @id @default(autoincrement())
  public_id                                                                     String                   @unique(map: "audit_logs_public_id_unique") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at                                                                   DateTime                 @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  clinic_timezone                                                               String                   @default("Asia/Jakarta")
  actor_user_id                                                                 BigInt?
  actor_username_snapshot                                                       String?
  actor_role_snapshot                                                           String?
  session_id                                                                    BigInt?
  patient_id                                                                    BigInt?
  registration_id                                                               BigInt?
  resource_type                                                                 String
  resource_public_id                                                            String?                  @db.Uuid
  before_version_id                                                             BigInt?
  after_version_id                                                              BigInt?
  action                                                                        String
  outcome                                                                       String
  purpose                                                                       String?
  reason                                                                        String?
  request_id                                                                    String
  ip_address                                                                    String?                  @db.Inet
  user_agent                                                                    String?
  metadata                                                                      Json                     @default("{}")
  users                                                                         users?                   @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  medical_record_versions_audit_logs_after_version_idTomedical_record_versions  medical_record_versions? @relation("audit_logs_after_version_idTomedical_record_versions", fields: [after_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  medical_record_versions_audit_logs_before_version_idTomedical_record_versions medical_record_versions? @relation("audit_logs_before_version_idTomedical_record_versions", fields: [before_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patients                                                                      patients?                @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  registrations                                                                 registrations?           @relation(fields: [registration_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessions                                                                      sessions?                @relation(fields: [session_id, actor_user_id], references: [id, user_id], onDelete: Restrict, onUpdate: NoAction, map: "audit_logs_session_actor_fk")

  @@index([action, occurred_at(sort: Desc), id(sort: Desc)], map: "audit_logs_action_idx")
  @@index([actor_user_id, occurred_at(sort: Desc), id(sort: Desc)], map: "audit_logs_actor_user_idx")
  @@index([after_version_id])
  @@index([before_version_id])
  @@index([occurred_at(sort: Desc), id(sort: Desc)], map: "audit_logs_occurred_at_idx")
  @@index([patient_id, occurred_at(sort: Desc), id(sort: Desc)], map: "audit_logs_patient_idx")
  @@index([registration_id])
  @@index([request_id, occurred_at(sort: Desc), id(sort: Desc)], map: "audit_logs_request_id_idx")
  @@index([resource_type, resource_public_id, occurred_at(sort: Desc), id(sort: Desc)], map: "audit_logs_resource_idx")
  @@index([session_id])
}

